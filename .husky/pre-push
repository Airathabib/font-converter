#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🛡️ Запуск проверок перед отправкой кода..."

# 1. Запускаем lint-staged (проверяет только измененные файлы)
npx lint-staged --allow-empty

# 2. Проверяем типы (быстрее, чем полная сборка)
# Если хотите полную сборку, оставьте 'npm run build'
npm run typecheck 

echo "✅ Проверки пройдены успешно!"
