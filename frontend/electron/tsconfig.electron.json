{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "../dist-electron",
		"rootDir": ".",
		"baseUrl": ".",
		"types": ["node"],
		"allowSyntheticDefaultImports": true,
		"declaration": true,

		"lib": ["ES2020"],
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["../src/*"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "../dist-electron"]
}
